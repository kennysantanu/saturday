{
	"name": "saturday",
	"private": true,
	"version": "0.1.4",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"assistant": "node scripts/assistant.mjs",
		"access": "node scripts/access.mjs",
		"dev": "node scripts/dev.mjs",
		"build": "npm run check:release && vite build && npm run build:mcp",
		"build:mcp": "node scripts/build-mcp.mjs",
		"migrate": "node scripts/migrate.mjs",
		"start": "node scripts/start.mjs",
		"status": "node scripts/status.mjs",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node tests/run.mjs check",
		"check:release": "node scripts/check-release.mjs",
		"release:freeze": "node scripts/check-release.mjs --freeze",
		"check:scripts": "node scripts/check-scripts.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"backup": "node scripts/backup.mjs",
		"restore": "node scripts/restore.mjs",
		"test": "node tests/run.mjs unit",
		"test:contracts": "node tests/run.mjs contracts",
		"test:cloudflare": "node tests/run.mjs cloudflare",
		"test:web": "node tests/run.mjs web",
		"test:beta": "node tests/run.mjs beta",
		"verify": "node tests/run.mjs verify",
		"files": "node scripts/files.mjs",
		"setup:pdf": "puppeteer browsers install chrome",
		"extension": "node scripts/extensions.mjs",
		"extensions:generate": "node scripts/extension-build.mjs",
		"open": "node scripts/start.mjs open",
		"stop": "node scripts/start.mjs stop",
		"restart": "node scripts/start.mjs restart",
		"update:check": "node scripts/install.mjs check",
		"update": "node scripts/install.mjs update",
		"repair": "node scripts/install.mjs repair",
		"uninstall": "node scripts/install.mjs uninstall",
		"test:large": "node tests/run.mjs large"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"esbuild": "^0.28.2",
		"miniflare": "4.20260730.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-table": "3.31.4",
		"@tiptap/markdown": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"marked": "^17.0.6",
		"puppeteer": "^25.16.0",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1",
		"zod": "^4.6.7"
	},
	"overrides": {
		"miniflare": {
			"sharp": "0.35.5",
			"undici": "7.30.1"
		}
	},
	"saturday": {
		"installation_api": 1,
		"access_api": 1,
		"lan_api": 1,
		"node_minimum": "22.13.0",
		"storage": {
			"database": {
				"format": "saturday.database",
				"minimumVersion": 1,
				"currentVersion": 1
			},
			"manifest": {
				"format": "saturday.files",
				"minimumVersion": 1,
				"version": 1
			}
		}
	}
}
